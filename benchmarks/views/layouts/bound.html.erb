<!DOCTYPE html>
<html>
  <head><title>ViewBind Bench</title><%= bind_render "layouts/style" %></head>
  <body>
    <%= bind_render "shared/header_bound", current_path: @current_path, user: @user %>
    <% @flashes.each do |level, message| %><%= bind_render "shared/flash", level: level, message: message %><% end %>
    <main><%= yield %></main>
    <%= bind_render "shared/sidebar_bound" %>
    <%= bind_render "shared/footer_bound" %>
  </body>
</html>
