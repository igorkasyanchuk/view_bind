<style>
  :root { color-scheme: light; }
  body { background: #f6f6f4; color: #1c1b1a; font: 15px/1.5 -apple-system, "Segoe UI", sans-serif; margin: 0; }
  a { color: #7a1020; }
  .site-header { display: flex; gap: 20px; align-items: center; flex-wrap: wrap;
                 padding: 12px 24px; background: #fff; border-bottom: 1px solid #e2e0dc; }
  .brand { font-weight: 700; text-decoration: none; }
  .nav, .footer-links { display: flex; gap: 14px; list-style: none; margin: 0; padding: 0; }
  .nav-item.is-active a { font-weight: 700; }
  .totals { color: #6b6862; font-size: 13px; }
  .user { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .avatar { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
            background: #7a1020; color: #fff; font-size: 11px; font-weight: 700; }
  .btn { border: 1px solid #d6d3ce; background: #fff; border-radius: 6px; padding: 3px 9px; font-size: 13px; }
  .btn-primary { background: #7a1020; border-color: #7a1020; color: #fff; }
  .flash { padding: 8px 24px; background: #fff8e1; border-bottom: 1px solid #f0e4bd; font-size: 13px; }
  main { padding: 20px 24px; }
  h1 { font-size: 22px; margin: 0 0 16px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .card { background: #fff; border: 1px solid #e2e0dc; border-radius: 10px; padding: 14px; }
  .card-title { font-size: 16px; margin: 0 0 6px; }
  .byline { display: flex; gap: 8px; align-items: center; font-size: 13px; color: #6b6862; }
  .card-body { font-size: 13px; color: #45423e; }
  .tags { display: flex; gap: 6px; list-style: none; margin: 8px 0; padding: 0; flex-wrap: wrap; }
  .tag { font-size: 12px; background: #efece7; border-radius: 999px; padding: 1px 8px; }
  .tag a { text-decoration: none; }
  .actions { display: flex; gap: 6px; margin-top: 8px; }
  .ownership { font-size: 12px; color: #86827b; margin: 8px 0 0; }
  .badge { background: #efece7; border-radius: 4px; padding: 0 5px; }
  .sidebar { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; padding: 0 24px 24px; }
  .widget { background: #fff; border: 1px solid #e2e0dc; border-radius: 10px; padding: 12px; }
  .widget h4 { margin: 0 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: #86827b; }
  .widget ul { list-style: none; margin: 0; padding: 0; font-size: 13px; }
  .row { display: flex; justify-content: space-between; padding: 2px 0; }
  .comment { padding: 4px 0; border-top: 1px solid #f0eee9; font-size: 12px; }
  .site-footer { padding: 16px 24px; border-top: 1px solid #e2e0dc; color: #86827b; font-size: 12px;
                 display: flex; gap: 16px; align-items: center; }
</style>
