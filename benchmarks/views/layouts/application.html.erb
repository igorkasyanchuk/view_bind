<!DOCTYPE html>
<html>
  <head><title>ViewBind Bench</title></head>
  <body>
    <%= render "shared/header", current_path: @current_path, user: @user %>
    <% @flashes.each do |level, message| %><%= render "shared/flash", level: level, message: message %><% end %>
    <main><%= yield %></main>
    <%= render "shared/sidebar" %>
    <%= render "shared/footer" %>
  </body>
</html>
