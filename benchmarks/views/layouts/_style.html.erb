<style>
  :root {
    color-scheme:light;
    --ink:#202a32;
    --muted:#626e77;
    --blue:#2357da;
    --line:#e2e6e8
  }
  * {
    box-sizing:border-box
  }
  html {
    scroll-behavior:smooth
  }
  body {
    margin:0;
    background:#f7f8fa;
    color:var(--ink);
    font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
  }
  a {
    color:inherit;
    text-decoration:none
  }
  a:hover {
    color:var(--blue)
  }
  button {
    font:inherit;
    cursor:pointer
  }
  a:focus-visible,button:focus-visible {
    outline:3px solid #729dff;
    outline-offset:4px
  }
  .site-header {
    background:white;
    border-bottom:1px solid var(--line)
  }
  .header-inner {
    max-width:1320px;
    margin:auto;
    min-height:88px;
    padding:0 40px;
    display:flex;
    align-items:center;
    gap:48px
  }
  .brand {
    display:flex;
    align-items:center;
    gap:11px;
    font-size:23px;
    font-weight:800;
    letter-spacing:-1px
  }
  .brand-mark {
    display:grid;
    place-items:center;
    width:35px;
    height:35px;
    border-radius:10px;
    color:white;
    background:var(--blue);
    font:25px Georgia,serif
  }
  .brand small {
    display:block;
    font-size:9px;
    letter-spacing:1.6px;
    line-height:1.2;
    color:var(--muted)
  }
  .nav,.footer-links {
    display:flex;
    list-style:none;
    gap:26px;
    margin:0;
    padding:0;
    font-size:13px;
    font-weight:600
  }
  .nav-item.is-active a {
    color:var(--blue)
  }
  .user {
    margin-left:auto;
    display:flex;
    align-items:center;
    gap:12px
  }
  .user-name {
    font-size:12px
  }
  .avatar {
    display:inline-grid;
    place-items:center;
    flex-shrink:0;
    width:30px;
    height:30px;
    border-radius:50%;
    background:#e9edfc;
    color:#385c9a;
    font-size:10px;
    font-weight:750
  }
  .user .avatar {
    background:#efe4d9;
    color:#74563d;
    width:35px;
    height:35px
  }
  .btn {
    border:1px solid var(--line);
    background:white;
    border-radius:6px;
    padding:5px 11px;
    font-size:11px;
    color:var(--muted)
  }
  .btn:hover {
    border-color:var(--blue);
    color:var(--blue)
  }
  .btn-primary {
    background:var(--blue);
    border-color:var(--blue);
    color:white
  }
  .btn-primary:hover {
    background:#1744b8;
    color:white
  }
  .page-shell {
    max-width:1320px;
    margin:auto;
    padding:0 40px
  }
  .welcome {
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 0;
    border-bottom:1px solid var(--line);
    gap:20px
  }
  .welcome-label,.eyebrow {
    font-size:10px;
    font-weight:750;
    text-transform:uppercase;
    letter-spacing:1.7px;
    color:var(--blue)
  }
  .notices {
    display:flex;
    gap:16px;
    align-items:center
  }
  .flash {
    font-size:11px;
    color:var(--muted)
  }
  .flash-notice::before {
    content:"";
    display:inline-block;
    width:5px;
    height:5px;
    background:#438565;
    border-radius:50%;
    margin-right:6px
  }
  .flash-warning {
    border-left:1px solid var(--line);
    padding-left:16px
  }
  .masthead {
    padding:38px 0 34px;
    display:flex;
    align-items:end;
    justify-content:space-between;
    gap:24px
  }
  .masthead h1 {
    font:400 clamp(34px,4vw,52px)/1.12 Georgia,serif;
    letter-spacing:-1.9px;
    margin:0 0 12px
  }
  .masthead p {
    color:var(--muted);
    font-size:13px;
    margin:0
  }
  .edition {
    text-align:right;
    font-size:10px;
    letter-spacing:1.1px;
    line-height:1.9;
    text-transform:uppercase;
    color:var(--muted);
    flex-shrink:0
  }
  .edition strong {
    color:var(--ink);
    display:block
  }
  .content-grid {
    display:grid;
    grid-template-columns:minmax(0,1fr) 282px;
    gap:36px;
    align-items:start;
    padding-bottom:48px
  }
  main {
    min-width:0
  }
  .section-heading {
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin:0 0 18px;
    padding-bottom:12px;
    border-bottom:1px solid var(--line)
  }
  .section-heading h2 {
    margin:0;
    font-size:13px
  }
  .section-heading span {
    font-size:10px;
    color:var(--muted)
  }
  .cards {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:20px
  }
  .card {
    display:flex;
    flex-direction:column;
    min-width:0;
    padding:25px;
    background:white;
    border:1px solid var(--line);
    border-radius:10px
  }
  .card-topline {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:15px
  }
  .category {
    color:var(--blue);
    font-size:9px;
    font-weight:750;
    text-transform:uppercase;
    letter-spacing:1.4px
  }
  .reading-time {
    color:var(--muted);
    font-size:10px;
    white-space:nowrap
  }
  .card-title {
    margin:0 0 14px;
    font:400 24px/1.24 Georgia,serif;
    letter-spacing:-.4px
  }
  .byline {
    display:flex;
    align-items:center;
    gap:9px;
    font-size:10px;
    color:var(--muted)
  }
  .card-body {
    color:var(--muted);
    font-size:12px;
    line-height:1.8;
    margin:16px 0 10px
  }
  .tags {
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    list-style:none;
    padding:0;
    margin:8px 0
  }
  .tag {
    font-size:9px;
    background:#f2f4f7;
    border:1px solid #e9edf1;
    border-radius:4px;
    padding:2px 7px;
    color:#536576
  }
  .ownership {
    font-size:9px;
    color:#737e87;
    margin:10px 0
  }
  .badge {
    display:inline-block;
    border-radius:3px;
    padding:0 4px;
    font-size:8px;
    background:#edf0f4
  }
  .actions {
    display:flex;
    gap:6px;
    margin-top:auto;
    padding-top:15px;
    border-top:1px solid var(--line)
  }
  .actions .btn-primary {
    margin-right:auto
  }
  .cards>.card:first-child {
    grid-column:1/-1;
    position:relative;
    overflow:hidden;
    padding:32px;
    background:#142b42;
    border-color:#142b42;
    color:white
  }
  .cards>.card:first-child::after {
    content:"";
    position:absolute;
    width:340px;
    height:340px;
    border:1px solid #496278;
    border-radius:50%;
    right:-145px;
    top:-120px;
    box-shadow:0 0 0 35px #ffffff04,0 0 0 70px #ffffff04,0 0 0 105px #ffffff03;
    pointer-events:none
  }
  .cards>.card:first-child>* {
    position:relative;
    z-index:1
  }
  .cards>.card:first-child .category {
    color:#a7c5f3
  }
  .cards>.card:first-child .category::before {
    content:"EDITOR'S PICK  /  ";
    color:#7f9bb9
  }
  .cards>.card:first-child .card-title {
    max-width:570px;
    font-size:34px
  }
  .cards>.card:first-child .card-body {
    max-width:630px;
    color:#bbc9d6;
    font-size:13px
  }
  .cards>.card:first-child .byline,.cards>.card:first-child .ownership,.cards>.card:first-child .reading-time {
    color:#aebed0
  }
  .cards>.card:first-child .tag,.cards>.card:first-child .badge {
    background:#263e55;
    border-color:#35506b;
    color:#c5d3df
  }
  .cards>.card:first-child .actions {
    border-color:#354b61;
    margin-top:12px
  }
  .cards>.card:first-child a:hover {
    color:#a7c5f3
  }
  .sidebar {
    display:flex;
    flex-direction:column;
    gap:20px
  }
  .sidebar-intro {
    padding:24px;
    background:#eaf0fa;
    border:1px solid #dae3f2;
    border-radius:10px
  }
  .sidebar-intro h3 {
    font:400 25px/1.2 Georgia,serif;
    margin:10px 0;
    letter-spacing:-.5px
  }
  .sidebar-intro p {
    font-size:11px;
    color:var(--muted);
    margin:0 0 18px
  }
  .community-stats {
    display:flex;
    gap:24px;
    padding-top:14px;
    border-top:1px solid #d2ddec
  }
  .community-stats strong {
    display:block;
    font-size:19px;
    color:#24497b;
    line-height:1.2
  }
  .community-stats span {
    font-size:9px;
    color:var(--muted)
  }
  .widget {
    padding:0 0 20px;
    border-bottom:1px solid var(--line)
  }
  .widget h4 {
    margin:0 0 14px;
    font-size:11px
  }
  .widget ul,.ranked {
    list-style:none;
    margin:0;
    padding:0
  }
  .widget .tags {
    gap:7px
  }
  .widget .tag {
    background:white;
    padding:4px 9px;
    font-size:10px
  }
  .row {
    display:flex;
    justify-content:space-between;
    gap:12px;
    padding:5px 0;
    font-size:11px
  }
  .row .k {
    text-transform:capitalize
  }
  .row .v {
    color:var(--muted);
    font-size:10px;
    font-variant-numeric:tabular-nums
  }
  .ranked-row {
    display:flex;
    align-items:start;
    gap:9px;
    padding:9px 0
  }
  .ranked-row .k {
    flex:1;
    font-size:11px;
    font-weight:600;
    line-height:1.5
  }
  .ranked-row .v {
    color:var(--muted);
    font-size:9px;
    white-space:nowrap
  }
  .comment {
    padding:10px 0;
    border-top:1px solid var(--line);
    font-size:10px;
    color:var(--muted)
  }
  .comment b {
    color:var(--ink)
  }
  .comment span {
    display:block;
    margin-top:4px
  }
  .site-footer {
    max-width:1240px;
    margin:auto;
    padding:25px 0 35px;
    border-top:1px solid var(--line);
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:24px
  }
  .footer-brand {
    font-size:13px;
    font-weight:700
  }
  .footer-brand span {
    display:block;
    font-size:10px;
    color:var(--muted);
    font-weight:400;
    margin-top:3px
  }
  .footer-links {
    font-size:10px;
    gap:20px
  }
  .site-footer small {
    font-size:9px;
    color:var(--muted)
  }
  @media(max-width:1050px) {
    .header-inner {
      gap:25px
    }
    .nav {
      gap:16px
    }
    .content-grid {
      gap:24px;
      grid-template-columns:minmax(0,1fr) 250px
    }
    .card {
      padding:20px
    }
    .card-title {
      font-size:22px
    }
    .user-name {
      display:none
    }
    .site-footer {
      margin:0 40px
    }
  }
  @media(max-width:780px) {
    .header-inner {
      padding:16px 22px;
      flex-wrap:wrap;
      gap:16px
    }
    .header-inner nav {
      order:3;
      width:100%
    }
    .nav {
      justify-content:space-between
    }
    .user {
      margin-left:auto
    }
    .page-shell {
      padding:0 22px
    }
    .content-grid {
      grid-template-columns:1fr
    }
    .sidebar {
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:24px;
      margin-top:8px
    }
    .edition {
      display:none
    }
    .masthead {
      padding:30px 0
    }
    .welcome-label {
      display:none
    }
    .welcome {
      padding:14px 0
    }
    .site-footer {
      margin:0 22px;
      flex-wrap:wrap
    }
  }
  @media(max-width:480px) {
    .cards,.sidebar {
      grid-template-columns:1fr
    }
    .cards>.card:first-child {
      padding:24px
    }
    .cards>.card:first-child .card-title {
      font-size:29px
    }
    .masthead h1 {
      font-size:36px
    }
    .notices {
      flex-wrap:wrap;
      gap:8px
    }
    .flash-warning {
      padding-left:10px
    }
    .site-footer {
      align-items:start
    }
    .site-footer small {
      width:100%
    }
  }
  @media(prefers-reduced-motion:reduce) {
    html {
      scroll-behavior:auto
    }
  }
</style>
