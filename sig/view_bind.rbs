# Signatures for the public API. ActionView objects are untyped: a view context, a Template
# and a LookupContext have no shipped RBS, and describing them here would be guesswork.
#
# ViewBind::Railtie is absent for a narrower reason: `rbs validate` rejects it. It subclasses
# ::Rails::Railtie, which ships no signature, and declaring the class without that superclass
# would assert it inherits from Object -- a worse answer than no answer. Add it here if and
# when a Rails RBS is available.
module ViewBind
  VERSION: String

  # resolver context => virtual path => [[locals keys, Bound], ...]
  CACHE: untyped

  class Bound < ::Struct[untyped]
    attr_accessor template: untyped
    attr_accessor method_name: Symbol?
    attr_accessor slow: bool
    attr_accessor unbound_method: UnboundMethod?
  end

  def self.profile=: (bool) -> bool
  def self.profile?: () -> bool
  def self.bound_for: (untyped view, String path, Array[Symbol] keys) -> Bound
  def self.bound_for_locals: (untyped view, String path, Hash[Symbol, untyped] locals) -> Bound
  def self.context_for: (untyped view) -> Array[untyped]
  def self.bindings_for: (untyped view) -> untyped
  def self.clear_cache: () -> void
  def self.fast_path_available?: () -> bool

  # Included into every view, partial and layout.
  module Helper
    MEMO_LIMIT_PER_SHAPE: Integer

    def bind_render: (String path, **untyped locals) -> nil
    def bind_capture: (String path, **untyped locals) -> untyped
    def bind_render_memo: (String path, **untyped locals) -> nil
    def bind_render_each: (String path, untyped collection, as: Symbol, **untyped shared) -> nil
  end

  # Teaches ActionView::Digestor about the bind_* helpers.
  class Tracker
    DIRECTIVE: Regexp

    def self.wrapped: () -> Hash[untyped, untyped]
    def self.supports_view_paths?: () -> bool
    def self.register_for: (Symbol | String extension) -> untyped
    def self.call: (String name, untyped template, ?untyped view_paths) -> Array[String]
    def self.default_tracker: () -> untyped
  end

  # One summary line per request in place of Rails' per-partial log lines.
  module Profiler
    KEY: Symbol
    DEPTH: Symbol

    def self.measure: (String path, ?count: Integer, ?memo_hits: Integer) { () -> untyped } -> untyped
    def self.measure_memo: (String path) { () -> untyped } -> untyped
    def self.record: (String path, Float elapsed, ?count: Integer, ?memo_hits: Integer, ?top_level: bool) -> void
    def self.store: () -> Hash[String, Array[untyped]]
    def self.reset: () -> void
    def self.summary: (?limit: Integer) -> String?
  end
end
