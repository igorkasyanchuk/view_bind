<aside class="sidebar" aria-label="Topics and community">
  <section class="sidebar-intro" id="community">
    <span class="eyebrow">Better, together</span>
    <h3>A community<br>of curious minds.</h3>
    <p>Fresh perspectives from people building the next thing. Pull up a chair.</p>
    <div class="community-stats"><div><strong><%= number_with_delimiter(@totals[:posts]) %></strong><span>Stories shared</span></div><div><strong><%= number_with_delimiter(@totals[:comments]) %></strong><span>Conversations</span></div></div>
  </section>
  <div class="section-heading" id="topics"><h2>Explore the community</h2></div>
  <% WIDGETS.each do |title, items| %><%= bind_render "shared/widget_bound", title: title, items: items %><% end %>
  <section class="widget">
    <h4>Top categories</h4>
    <ul><% @top_categories.each do |category, total| %><%= bind_render "shared/category_row", category: category, total: total %><% end %></ul>
  </section>
  <section class="widget">
    <h4>Busiest authors</h4>
    <ul><% @busiest_authors.each do |name, total| %><%= bind_render "shared/author_row", name: name, total: total %><% end %></ul>
  </section>
  <%= bind_render "shared/top_monthly_bound" %>
  <section class="widget">
    <h4>Recent comments</h4>
    <ul><%= bind_render_each "shared/comment_row", @recent_comments, as: :comment %></ul>
  </section>
</aside>
